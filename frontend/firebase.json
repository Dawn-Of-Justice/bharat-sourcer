{
  "hosting": [
    {
      "site": "bharatsourcer",
      "public": "hosting",
      "ignore": ["**/.*"],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "bharat-sourcer-web",
            "region": "asia-south1"
          }
        }
      ],
      "headers": [
        {
          "source": "/ucp-agent-profile.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, stale-while-revalidate=7200"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ]
    },
    {
      "site": "bharatsource",
      "public": "hosting",
      "ignore": ["**/.*"],
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://bharatsourcer.web.app/:path",
          "type": 301
        }
      ]
    }
  ]
}
