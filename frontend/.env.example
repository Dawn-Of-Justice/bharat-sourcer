# Public Firebase web app configuration (not a service-account key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Direct local API calls are suitable for legacy development.
# Guest cookies require HTTPS and the same-origin production proxy.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional team integration key, injected server-side by the Vite dev proxy as
# X-Integration-Key. Never give it a VITE_ prefix (that would ship it to the browser).
INTEGRATION_KEY=

# The production server (server.mjs) does not read this file. It takes these from the
# process environment (Cloud Run): BACKEND_BASE_URL (HTTPS), INTEGRATION_KEY,
# FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_PROJECT_ID, FIREBASE_APP_ID,
# and optionally PORT (default 8080) and HOST (default 0.0.0.0).
