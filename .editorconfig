root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,mjs,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[frontend/**.{ts,tsx,js,mjs,json,css,html}]
max_line_length = 120

[*.{ps1,cmd,bat}]
end_of_line = crlf
