# Demo mode needs no credentials. Live mode supports public YouTube videos only.
BS_DEMO_MODE=true
# Optional team integration access. Every /v1 request needs X-Integration-Key when set.
BS_INTEGRATION_KEY=
# Enable only after Firebase Google sign-in and credential-forwarding proxy are ready.
BS_AUTH_ENABLED=false
# Last-resort illustrations: separate image-generation budget, cached per account/name.
BS_IMAGE_GENERATION_ENABLED=false
BS_IMAGE_MODEL=gemini-3.1-flash-lite-image
BS_IMAGE_DAILY_LIMIT=30
# AI-drafted code patches for substitutes (tier 2); off until approved.
BS_CODE_ADAPT_AI=false
BS_CODE_ADAPT_DAILY_LIMIT=50
# Compile checks of code patches (tier 3) in isolated Cloud Run jobs; set by
# scripts/setup_compile_runner.py on Cloud Run. none answers 503 COMPILE_UNAVAILABLE.
BS_COMPILE_BACKEND=none
BS_COMPILE_DAILY_LIMIT=100
# Independent random secret of at least 32 characters, never expose to Vite.
BS_GUEST_SESSION_SECRET=
BS_GUEST_SESSION_DAYS=14
BS_GUEST_PART_LIMIT=3
BS_GUEST_DAILY_ACTIONS=5
BS_ACCOUNT_DAILY_ACTIONS=40
BS_IP_DAILY_ACTIONS=100
BS_GLOBAL_DAILY_ACTIONS=1000
# Enable only when an integration-authenticated proxy overwrites X-Client-IP.
BS_TRUSTED_PROXY_IP_HEADER=false
BS_STORAGE_BACKEND=memory
# Local mode uses background tasks. Cloud mode is provisioned by enable_queued_dispatch.py.
BS_DISPATCH_BACKEND=local
BS_GCP_PROJECT=hackathon-510415
BS_FIRESTORE_DATABASE=(default)
BS_FIRESTORE_COLLECTION=backend_jobs
BS_RECOVERY_INTERVAL_S=30
BS_EXTRACTION_LEASE_S=600
BS_GEMINI_API_KEY=
BS_GEMINI_MODEL=gemini-3.8-flash
BS_EXTRACTION_TIMEOUT_S=120
BS_SOURCING_ENABLED=true
BS_SOURCING_MAX_PARTS=30
BS_SOURCING_PARALLELISM=3
BS_SOURCING_CANDIDATES_PER_PART=5
BS_SOURCING_LEASE_S=1800
# Research reuses discovered pages; one extra bounded Gemini request per sourced part.
BS_RESEARCH_ENABLED=true
BS_RESEARCH_FOLLOWUP_ENABLED=true
BS_RESEARCH_PAGES_PER_PART=3
BS_RESEARCH_PAGE_CHARS=12000
BS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
