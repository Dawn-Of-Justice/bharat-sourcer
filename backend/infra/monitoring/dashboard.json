      },
      {
        "xPos": 0,
        "yPos": 24,
        "width": 16,
        "height": 10,
        "widget": {
          "title": "API: requests/s by class",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_AREA",
                "legendTemplate": "{{response_code_class}}",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (response_code_class) (rate(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"bharat-sourcer-integration\"}[5m]))"
                }
              }
            ],
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 24,
        "width": 16,
        "height": 10,
        "widget": {
          "title": "API: latency p50 / p95 / p99 (s, includes SSE streams)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "legendTemplate": "p50",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.5, sum by (le) (rate(run_googleapis_com:request_latencies_bucket{monitored_resource=\"cloud_run_revision\",service_name=\"bharat-sourcer-integration\"}[5m]))) / 1000",
                  "unitOverride": "s"
                }
              },
              {
                "plotType": "LINE",
                "legendTemplate": "p95",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le) (rate(run_googleapis_com:request_latencies_bucket{monitored_resource=\"cloud_run_revision\",service_name=\"bharat-sourcer-integration\"}[5m]))) / 1000",
                  "unitOverride": "s"
                }
              },
              {
                "plotType": "LINE",
                "legendTemplate": "p99",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.99, sum by (le) (rate(run_googleapis_com:request_latencies_bucket{monitored_resource=\"cloud_run_revision\",service_name=\"bharat-sourcer-integration\"}[5m]))) / 1000",
                  "unitOverride": "s"
                }
              }
            ],
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 32,
        "yPos": 24,
        "width": 16,
        "height": 10,
        "widget": {
          "title": "API: 5xx ratio (excl. SSE and /internal/*)",
          "xyChart": {
            "dataSets": [
