                "plotType": "LINE",
                "legendTemplate": "5xx ratio",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(rate(logging_googleapis_com:user_api_request_count{monitored_resource=\"cloud_run_revision\",status=~\"5..\"}[10m])) / sum(rate(logging_googleapis_com:user_api_request_count{monitored_resource=\"cloud_run_revision\"}[10m]))"
                }
              }
            ],
            "chartOptions": {
              "mode": "COLOR"
            },
            "thresholds": [
