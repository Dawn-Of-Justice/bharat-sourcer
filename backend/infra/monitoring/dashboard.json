            "dataSets": [
              {
                "plotType": "LINE",
                "legendTemplate": "{{check_id}}",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "prometheusQuery": "min by (check_id) (monitoring_googleapis_com:uptime_check_check_passed{monitored_resource=\"uptime_url\"})"
                }
              }
            ],
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
